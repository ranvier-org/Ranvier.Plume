<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <!-- The state package's two targets. The view's tests run on net10.0, the only target of the native host. -->
        <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
        <LangVersion>latest</LangVersion>
        <IsPackable>false</IsPackable>
        <GenerateProgramFile>false</GenerateProgramFile>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Helpers.fs" />
        <Compile Include="TextTests.fs" />
        <Compile Include="ChangeSetTests.fs" />
        <Compile Include="SelectionTests.fs" />
        <Compile Include="StateTests.fs" />
        <Compile Include="HistoryTests.fs" />
        <Compile Include="EditorTests.fs" />
        <Compile Include="CommandTests.fs" />
        <Compile Include="Main.fs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Expecto" Version="11.0.0-alpha8" />
        <PackageReference Include="YoloDev.Expecto.TestSdk" Version="0.15.5" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.4.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Ranvier.Plume\Ranvier.Plume.fsproj" />
    </ItemGroup>
</Project>
