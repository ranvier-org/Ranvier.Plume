<Project>
    <Import Project="$(MSBuildThisFileDirectory)Local.Build.props" Condition="Exists('$(MSBuildThisFileDirectory)Local.Build.props')" />

    <PropertyGroup>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <RepositoryUrl>https://github.com/ranvier-org/Ranvier.Plume</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Authors>shayanhabibi</Authors>
        <Copyright>Copyright (c) 2026 Shayan Habibi</Copyright>
        <PackageProjectUrl>https://ranvier-org.github.io/Ranvier.Plume/</PackageProjectUrl>
        <PackageReleaseNotes>Selects .Traced package twins across keyboard and CSS dependencies when RanvierTrace=true, and aligns Ranvier cohort floors.</PackageReleaseNotes>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <!-- Fable.Package.SDK sets DebugType=embedded: the PDB (with SourceLink) lives in each dll, so no .snupkg is produced. -->
        <IncludeSymbols>false</IncludeSymbols>
        <RanvierVersion Condition="'$(RanvierVersion)' == ''">0.2.1</RanvierVersion>
        <RanvierKeyboardVersion Condition="'$(RanvierKeyboardVersion)' == ''">0.2.0</RanvierKeyboardVersion>
        <RanvierViewVersion Condition="'$(RanvierViewVersion)' == ''">0.4.0</RanvierViewVersion>
        <RanvierCssVersion Condition="'$(RanvierCssVersion)' == ''">0.3.0</RanvierCssVersion>
        <RanvierCssViewVersion Condition="'$(RanvierCssViewVersion)' == ''">0.3.1</RanvierCssViewVersion>
        <!-- A traced build is opt-in in every configuration: pass -p:RanvierTrace=true. -->
        <RanvierPackageSuffix Condition="'$(RanvierTrace)' == 'true'">.Traced</RanvierPackageSuffix>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>

    <!-- Packed projects only: a CI build maps source paths to /_/. -->
    <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true' and $(MSBuildProjectDirectory.StartsWith('$(MSBuildThisFileDirectory)src'))">
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>
</Project>
