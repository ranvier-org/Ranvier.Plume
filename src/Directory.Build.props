<Project>
    <Import Project="../Directory.Build.props" />

    <PropertyGroup>
        <FSharpCoreImplicitPackageVersion>9.0.100</FSharpCoreImplicitPackageVersion>
        <FablePackageType>library</FablePackageType>
        <DebugType>embedded</DebugType>
        <NuspecOutputPath Condition="'$(NuspecOutputPath)' == ''">$(MSBuildThisFileDirectory)../bin/nuspec/$(MSBuildProjectName)/$(Configuration)/</NuspecOutputPath>
    </PropertyGroup>

    <!-- A traced build's creation sites skip frames from an assembly with this marker. -->
    <ItemGroup>
        <AssemblyMetadata Include="RanvierLibrary" Value="true" />
    </ItemGroup>

</Project>
