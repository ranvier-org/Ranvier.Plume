<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>disable</Nullable>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <!-- "dotnet publish" with no -r publishes for the platform it runs on. Without a runtime identifier the output
       carries the native engine of every platform. -->
  <PropertyGroup Condition="'$(_IsPublishing)' == 'true' and '$(RuntimeIdentifier)' == ''">
    <RuntimeIdentifier>$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
    <SelfContained Condition="'$(SelfContained)' == ''">false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Png.fs" />
    <Compile Include="Sample.fs" />
    <Compile Include="Lexer.fs" />
    <Compile Include="Model.fs" />
    <Compile Include="Styles.fs" />
    <Compile Include="LiveSheet.fs" />
    <Compile Include="App.fs" />
    <Compile Include="Harness.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ranvier.Plume\Ranvier.Plume.fsproj" />
    <ProjectReference Include="..\..\src\Ranvier.Plume.View\Ranvier.Plume.View.fsproj" />
    <PackageReference Include="Ranvier.View.WebCore.Sdl" Version="0.2.0" />
  </ItemGroup>

  <!-- Hot reload runs under the JIT only, so it is a Debug-only reference, used by "dotnet run" with the dev argument. -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageReference Include="Ranvier.View.WebCore.Hmr" Version="0.1.2" />
  </ItemGroup>

  <!-- The build has no CSS step and the output no CSS file: LiveSheet.fs records the rules of each class where
       styles { ... } applies it, adds the classes and rules of the editor view, and gives them to the engine as a
       constructed stylesheet. -->

</Project>
